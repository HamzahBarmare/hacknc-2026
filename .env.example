# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=your-project-id
PROJECT_SECRET=your-project-secret

# Summarizer: key + model for any OpenAI-compatible provider.
# Gemini free tier (recommended):
#   OPENAI_API_KEY=<key from https://aistudio.google.com/apikey>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-flash-latest
# Groq free tier:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# OpenRouter free models:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-latest

# Optional overrides.
# TIMEZONE=America/New_York
# DB_PATH=messages.db
