# This app uses the LOCAL iMessage provider: it reads your Mac's own
# Messages database (~/Library/Messages/chat.db) and sends from your own
# iMessage account. No PROJECT_ID/SECRET or cloud line is needed.

# Optional safety: only these handles (~/+ phone or email) may trigger a
# summary. Comma-separated. Leave empty to allow anyone in the group.
# ALLOWED_SENDERS=+15551234567,me@example.com

# Summarizer: key + model for any OpenAI-compatible provider.
# NOTE: the summary transcript is sent to this provider. Greet each group's
# messages accordingly (Gemini free tier may use data to improve models).
# Gemini free tier (recommended):
#   OPENAI_API_KEY=<key from https://aistudio.google.com/apikey>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-flash-latest
# Groq free tier:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# OpenRouter free models:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-latest

# Optional overrides.
# TIMEZONE=America/New_York
# DB_PATH=messages.db
